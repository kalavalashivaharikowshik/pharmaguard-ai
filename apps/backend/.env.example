# ---------------------------------------------------------------- required
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmaguard?schema=public"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
PORT=3000
# Web app URL(s), used for CORS in production and links in emails
FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=https://pharmaguard-ai.vercel.app,https://another-domain.com

# -------------------------------------------------------------- blockchain
# Local: run `npm run node` and `npm run deploy:local` in /blockchain
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Hardhat's first test account (public, local only). Use your own wallet key for Sepolia.
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ---------------------------------------------------------------------- AI
# Free key: https://aistudio.google.com/apikey  (without it, AI uses rule-based fallbacks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- optional
# Redis for the BullMQ job queue and cache (in-memory fallback when empty)
REDIS_URL=
# Email (activation / password reset). Without SMTP, links are written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMS for urgent alerts (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Push notifications: JSON of the Firebase service account (or put the file at firebase/serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT=
# Create demo users (one per role, password Demo@1234) on start-up
SEED_DEMO_DATA=false
