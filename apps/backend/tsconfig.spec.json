{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": [
      "jest",
      "node"
    ],
    "isolatedModules": true
  },
  "include": [
    "src/**/*.spec.ts"
  ]
}