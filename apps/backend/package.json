    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "crypto-js": "^4.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.4.2",
    "ethers": "^5.8.0",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.2.0",
    "ganache": "^7.9.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
