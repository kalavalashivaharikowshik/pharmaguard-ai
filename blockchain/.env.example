# Only needed to deploy to the public Sepolia testnet.
# Get a free RPC URL from Alchemy or Infura, and Sepolia test ETH from a faucet.
SEPOLIA_RPC_URL=
# Private key of a wallet that holds Sepolia test ETH. Never commit the real value.
DEPLOYER_PRIVATE_KEY=
# Optional: backend wallet address allowed to register/revoke batches.
REGISTRAR_ADDRESS=
